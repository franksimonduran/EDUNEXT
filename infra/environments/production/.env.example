# Template, NOT authorization or production configuration. Fase 48 gate is BLOCKED.
APP_ENV=production
DEBUG=false
DATABASE_URL=postgresql+asyncpg://aithron_app:replace-secret@database.example.invalid:5432/aithron_production
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA_FILE=/run/secrets/postgresql-ca.pem
EXPECTED_ALEMBIC_REVISION=phase45ai
SECRET_KEY=replace-with-operator-provided-signing-secret
CSRF_SECRET_KEY=replace-with-a-different-operator-secret
CORS_ORIGINS=https://application.example.invalid
TRUSTED_HOSTS=application.example.invalid
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
AITHRON_AI_ENABLED=false
SYNC_ENABLED=false
