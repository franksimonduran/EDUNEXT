# Reference only. No provider/domain/CA/secrets have been provisioned.
APP_ENV=staging
DEBUG=false
DATABASE_URL=postgresql+asyncpg://aithron_app:replace-secret@database.example.invalid:5432/aithron_staging
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA_FILE=/run/secrets/postgresql-ca.pem
EXPECTED_ALEMBIC_REVISION=phase45ai
SECRET_KEY=replace-with-operator-provided-signing-secret
CSRF_SECRET_KEY=replace-with-a-different-operator-secret
CORS_ORIGINS=https://staging.example.invalid
TRUSTED_HOSTS=staging.example.invalid
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
AITHRON_AI_ENABLED=false
SYNC_ENABLED=false
