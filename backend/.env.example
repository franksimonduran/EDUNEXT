# EDUNEXT Backend Configuration
# Copy this file to .env and replace every placeholder before starting the API.

# Application
APP_NAME=EDUNEXT Backend
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false

# API
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Security
SECRET_KEY=replace-with-a-random-64-character-value
ALGORITHM=HS256
JWT_ISSUER=aithron-edu
JWT_AUDIENCE=aithron-edu-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_MAX_AGE_SECONDS=2592000
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300

# CSRF
CSRF_SECRET_KEY=replace-with-a-different-random-64-character-value
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth/refresh

# Database (PostgreSQL only)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/athron_edu
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/athron_edu_test

# Logging
LOG_LEVEL=INFO

# Feature flags
EDUNEXT_AI_ENABLED=false
# Legacy AITHRON_AI_ENABLED remains accepted; EDUNEXT_AI_ENABLED takes priority.
# Optional local translation only: AI_PROVIDER_CODE=argos_local, install models explicitly.
AI_ARGOS_PACKAGES_DIR=
# Optional local-only adapter. No model is downloaded or selected automatically.
AI_PROVIDER_CODE=
AI_MODEL=
AI_OLLAMA_URL=http://127.0.0.1:11434
# Operator attestation: daemon/model verified local, cloud disabled and egress restricted.
AI_LOCAL_ONLY_ATTESTED=false
# Optional Google AI Studio / Gemini backend provider (never put keys in frontend).
# Set AI_PROVIDER_CODE=gemini_online and AI_MODEL to an available Gemini model ID.
# Requires explicit remote-processing approval plus institutional tutor approval.
# Leave disabled until authorized synthetic testing; remote requests may incur costs.
GEMINI_API_KEY=
AI_REMOTE_PROCESSING_APPROVED=false
AI_TIMEOUT_SECONDS=20
AI_MAX_INFLIGHT_PER_INSTITUTION=2
AI_MAX_OUTPUT_CHARACTERS=3000
AI_RETENTION_SWEEP_SECONDS=3600
SYNC_ENABLED=false

# Infrastructure policy. Staging/production require HTTPS origins, trusted hosts,
# non-administrative PostgreSQL role, verified TLS and an expected Alembic head.
TRUSTED_HOSTS=localhost,127.0.0.1,api
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA_FILE=
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_COMMAND_TIMEOUT_SECONDS=30
HEALTHCHECK_TIMEOUT_SECONDS=3
EXPECTED_ALEMBIC_REVISION=
